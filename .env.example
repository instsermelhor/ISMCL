# ── Aura Platform — Variáveis de Ambiente (Exemplo) ──────────────────────────
# Foundation Platform — Prompt 131 (AFPI)
#
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores conforme seu ambiente
# 3. NUNCA commite o arquivo .env no Git (já está no .gitignore)
# 4. Para produção, use variáveis de ambiente do servidor ou HashiCorp Vault
#
# Referências: P107 (AEIATP), P128 (AECS), P131 (AFPI)

# ── Aplicação ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Banco de Dados (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://aura:aura_dev_password@localhost:5432/aura_dev?schema=public"
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password
POSTGRES_DB=aura_dev
POSTGRES_PORT=5432

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aura_redis_password
REDIS_URL=redis://:aura_redis_password@localhost:6379

# ── JWT & Autenticação ────────────────────────────────────────────────────────
# IMPORTANTE: Substitua por um valor aleatório de 64+ caracteres em produção!
# Gere com: openssl rand -hex 32
JWT_SECRET=SUBSTITUA_ESTE_VALOR_POR_UM_SECRET_ALEATORIO_DE_64_CARACTERES_EM_PRODUCAO
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Keycloak / IAM (Opcional em desenvolvimento) ─────────────────────────────
# Descomente e configure se usar Keycloak localmente
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=aura
# KEYCLOAK_CLIENT_ID=aura-backend
# KEYCLOAK_CLIENT_SECRET=KEYCLOAK_CLIENT_SECRET_AQUI

# ── E-mail ────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=noreply@sermelhor.org.br
SMTP_PASSWORD=
SMTP_FROM="Instituto Ser Melhor <noreply@sermelhor.org.br>"
MAILHOG_UI_PORT=8025

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_APP_VERSION=1.0.0-dev
VITE_APP_NAME="Aura — Instituto Ser Melhor"

# ── HashiCorp Vault (Produção) ────────────────────────────────────────────────
# Descomente em staging/produção
# VAULT_ADDR=https://vault.sermelhor.org.br
# VAULT_TOKEN=VAULT_TOKEN_AQUI
# VAULT_NAMESPACE=aura

# ── AWS / Cloud Storage ───────────────────────────────────────────────────────
# Descomente em staging/produção
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AWS_KEY_AQUI
# AWS_SECRET_ACCESS_KEY=AWS_SECRET_AQUI
# S3_BUCKET=aura-documents-staging

# ── MinIO (Alternativa local ao S3) ──────────────────────────────────────────
# Descomente se usar MinIO local
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=aura-documents
# MINIO_USE_SSL=false

# ── Observabilidade ───────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=aura-backend
# GRAFANA_URL=http://localhost:3000

# ── Super Administrador Institucional (Prompt 177) ────────────────────────────
# ATENÇÃO: Os valores reais ficam APENAS no .env.local (gitignored).
# Este arquivo contém apenas placeholders para documentação.
# Em produção: use Vercel Environment Variables, Railway ou HashiCorp Vault.
VITE_AURA_SUPERADMIN_EMAIL=admin@seudominio.org
VITE_AURA_SUPERADMIN_PASS=SUBSTITUA_POR_SENHA_FORTE_NO_ENV_LOCAL

# Timeout de sessão administrativa em minutos
VITE_ADMIN_SESSION_TIMEOUT_MINUTES=30
