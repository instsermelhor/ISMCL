# ============================================================
# Aura Platform — Backend Environment Variables (EXAMPLE)
# ============================================================
# Copie este arquivo para .env.development (dev local)
# ou injete via Vault / K8s Secrets (produção).
# NUNCA commite .env.development com credenciais reais.
# ============================================================

NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aura_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & IAM
# Gere com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_minimum_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Keycloak (opcional — deixe vazio para usar JWT simétrico local em dev)
KEYCLOAK_URL=
KEYCLOAK_REALM=aura
KEYCLOAK_CLIENT_ID=aura-backend

# HashiCorp Vault (opcional em dev)
VAULT_ADDR=
VAULT_TOKEN=

# AWS (opcional em dev)
AWS_REGION=us-east-1
S3_BUCKET=

# ACTG — Aura Communication & Teleattendance Gateway
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_TOKEN=
GOOGLE_CALENDAR_ID=primary
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_USER_ID=
ACTG_WEBHOOK_SECRET=
