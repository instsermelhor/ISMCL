// =========================================================================
// PROJETO AURA - INSTITUTO SER MELHOR
// MÓDULO: GESTÃO DE PROJETOS E VOLUNTARIADO (ORM SCHEMA)
// =========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Beneficiary {
  id                  String   @id @default(uuid())
  fullName            String
  documentCpf         String?  @unique
  status              String   @default("ACTIVE")
  cases               Case[]
  triageQueues        TriageQueue[]
  appointments        Appointment[]
  waitlistEntries     WaitlistQueue[]
  
  // Módulo 05: Prontuário Eletrônico
  anamnesis           Anamnesis[]
  evolutions          ClinicalEvolution[]
  diagnoses           Diagnosis[]
  documents           ClinicalDocument[]
  attachments         ClinicalAttachment[]
  scales              ClinicalScale[]
  protectedProfile    ProtectedProfile?

  createdAt           DateTime @default(now())
}

model Professional {
  id                  String   @id @default(uuid())
  userId              String   @unique @default(uuid())// Vinculo com credenciais de login
  fullName            String
  socialName          String?
  cpf                 String   @unique
  birthDate           DateTime?
  gender              String?
  phone               String?
  email               String   @unique
  
  // Vínculo
  bondType            String   @default("VOLUNTEER") // VOLUNTEER, EMPLOYEE, PARTNER
  status              String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, SUSPENDED, INACTIVE
  joinedAt            DateTime @default(now())
  terminatedAt        DateTime?
  
  // Dados Clínicos/Técnicos
  profession          String?   // PSYCHOLOGIST, SOCIAL_WORKER, etc
  specialty           String?
  councilNumber       String?  // CRP, CRM
  councilState        String?
  councilStatus       String?
  
  // Relacionamentos
  professionalDocuments ProfessionalDocument[]
  availabilities      Availability[]
  
  projects            ProfessionalProject[]
  cases               CaseProfessional[]
  appointments        Appointment[]
  
  // Módulo 05: Prontuário Eletrônico
  anamnesis           Anamnesis[]
  evolutions          ClinicalEvolution[]
  erratas             EvolutionErrata[]
  diagnoses           Diagnosis[]
  clinicalDocuments   ClinicalDocument[]
  attachments         ClinicalAttachment[]
  documentAccessLogs  DocumentAccessLog[]
  attachmentAccessLogs AttachmentAccessLog[]
  scales              ClinicalScale[]
  
  // Módulo 06: Gestão de Casos e PIC
  casesOpened         Case[]                 @relation("CasesOpened")
  casesClosed         Case[]                 @relation("CasesClosed")
  casesReopened       Case[]                 @relation("CasesReopened")
  individualCarePlans IndividualCarePlan[]
  picGoals            PicGoal[]
  picVersions         PicVersion[]
  meetingsAttended    CaseMeetingParticipant[]
  referralsCreated    Referral[]
  requestsCreated     AccessRequest[]        @relation("RequesterProf")
  requestsAuthorized  AccessRequest[]        @relation("AuthorizerProf")
  accessSessions      AccessSession[]
  alertsResolved      BehaviorAlert[]        @relation("AlertResolver")
  
  createdAt           DateTime @default(now())
}

model ProfessionalDocument {
  id                  String   @id @default(uuid())
  professionalId      String
  type                String   // ID, DIPLOMA, COUNCIL_REGISTRY, ADDRESS
  fileUrl             String
  validUntil          DateTime?
  status              String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  
  professional        Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Availability {
  id                  String   @id @default(uuid())
  professionalId      String
  dayOfWeek           Int      // 0-6
  startTime           String   // HH:mm
  endTime             String   // HH:mm
  modality            String   // ONLINE, IN_PERSON, HYBRID
  
  professional        Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Project {
  id                  String   @id @default(uuid())
  name                String   // Ex: Projeto Mulheres
  description         String?
  
  professionals       ProfessionalProject[]
  cases               Case[]
  triageQueue         TriageQueue[]
  appointments        Appointment[]
  
  // Módulo 08: Gestão Financeira
  transactions        Transaction[]
}

// Relacionamento N:N - Quais voluntários atuam em quais projetos
model ProfessionalProject {
  professionalId      String
  projectId           String
  professional        Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@id([professionalId, projectId])
}

// Fila de Triagem - Beneficiários aguardando atendimento
model TriageQueue {
  id                  String   @id @default(uuid())
  beneficiaryId       String
  projectId           String
  priority            String   @default("NORMAL") // NORMAL, HIGH, URGENT
  enteredAt           DateTime @default(now())
  
  beneficiary         Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Case {
  id                  String   @id @default(uuid())
  beneficiaryId       String
  projectId           String
  status              String   @default("ACTIVE") // ACTIVE, CLOSED, REOPENED, TRANSFERRED
  priority            String   @default("NORMAL") // EMERGENTIAL, VERY_HIGH, HIGH, NORMAL, LOW
  
  // Módulo 06: Detalhes de Abertura e Controle
  openedById          String
  origin              String               // TRIAGE, INTERNAL_REFERRAL, EXTERNAL_REFERRAL, SPONTANEOUS_DEMAND, SOCIAL_PROJECT, JUDICIAL_DETERMINATION, INSTITUTIONAL_PARTNERSHIP
  reason              String
  classification      String               // DOMESTIC_VIOLENCE, PSYCHIC_DISTRESS, DEPRESSION, DRUG_DEPENDENCY, SOCIAL_VULNERABILITY, etc.
  
  // Alta e Reabertura
  closedAt            DateTime?
  closedById          String?
  closureReason       String?              // PLAN_COMPLETED, PATIENT_REQUEST, DEF_REFERRAL, LOST_CONTACT, OTHER
  evolutionSummary    String?              // Resumo final do caso para a alta (Criptografado)
  resultsAchieved     String?              // Resultados alcançados
  finalInstructions   String?              // Orientações para pós-alta
  reopenedAt          DateTime?
  reopenedById        String?
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relações
  beneficiary         Beneficiary          @relation(fields: [beneficiaryId], references: [id])
  project             Project              @relation(fields: [projectId], references: [id])
  assignedProfessionals CaseProfessional[]
  openedBy            Professional         @relation("CasesOpened", fields: [openedById], references: [id])
  closedBy            Professional?        @relation("CasesClosed", fields: [closedById], references: [id])
  reopenedBy          Professional?        @relation("CasesReopened", fields: [reopenedById], references: [id])

  // Relações Clínicas existentes
  anamnesis           Anamnesis[]
  evolutions          ClinicalEvolution[]
  diagnoses           Diagnosis[]
  documents           ClinicalDocument[]
  attachments         ClinicalAttachment[]
  scales              ClinicalScale[]

  // Relações do Módulo 06
  individualCarePlans IndividualCarePlan[]
  caseMeetings        CaseMeeting[]
  referrals           Referral[]
  caseAlerts          CaseAlert[]
}

// Relacionamento N:N - Quais profissionais estão alocados num caso
model CaseProfessional {
  caseId              String
  professionalId      String
  role                String   @default("PRIMARY_CLINICIAN") // PRIMARY, SUPPORT, SOCIAL_WORKER
  assignedAt          DateTime @default(now())
  
  case                Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  professional        Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  
  @@id([caseId, professionalId])
}

// =========================================================================
// MÓDULO 03: AGENDA INTELIGENTE E CENTRAL DE AGENDAMENTOS
// =========================================================================

model Appointment {
  id                  String   @id @default(uuid())
  title               String?  // Ex: "Primeiro Atendimento - Triagem"
  type                String   // THERAPY, PSYCHIATRY, SOCIAL_WORK, TRIAGE, EVENT
  modality            String   // ONLINE, IN_PERSON, HYBRID
  
  status              String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, CANCELLED, COMPLETED, NO_SHOW
  priority            String   @default("NORMAL")    // URGENT, HIGH, NORMAL, LOW
  
  scheduledStart      DateTime
  scheduledEnd        DateTime
  
  // Relacionamentos Principais
  beneficiaryId       String?
  professionalId      String
  projectId           String?
  resourceRoomId      String?  // Para salas físicas
  
  // Teleatendimento
  meetingLink         String?  // Link gerado automaticamente
  channelType         String?  // WHATSAPP_BUSINESS | GOOGLE_MEET | TEAMS | IN_PERSON | PHONE | HYBRID | WEBRTC_NATIVE
  appointmentChannel  AppointmentChannel?
  
  // Rastreabilidade
  cancellationReason  String?
  cancelledBy         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  beneficiary         Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  professional        Professional @relation(fields: [professionalId], references: [id])
  project             Project?     @relation(fields: [projectId], references: [id])
  resourceRoom        ResourceRoom? @relation(fields: [resourceRoomId], references: [id])
  
  // Módulo 05: Prontuário Eletrônico
  evolutions          ClinicalEvolution[]
}

model ResourceRoom {
  id                  String   @id @default(uuid())
  name                String   // Ex: Consultório 1
  type                String   // CLINICAL, AUDITORIUM, MEETING
  isActive            Boolean  @default(true)
  
  appointments        Appointment[]
}

model WaitlistQueue {
  id                  String   @id @default(uuid())
  beneficiaryId       String
  requestedSpecialty  String   // Ex: PSYCHOLOGY
  priorityScore       Int      // Algoritmo de IA calcula o peso
  status              String   @default("WAITING") // WAITING, INVITED, RESOLVED
  enteredAt           DateTime @default(now())
  
  beneficiary         Beneficiary @relation(fields: [beneficiaryId], references: [id])
}

// =========================================================================
// MÓDULO 05: PRONTUÁRIO ELETRÔNICO INTELIGENTE (PEI) E GESTÃO CLÍNICA
// =========================================================================

model Anamnesis {
  id                String       @id @default(uuid())
  caseId            String
  beneficiaryId     String
  professionalId    String       // Profissional que realizou o preenchimento
  chiefComplaint    String       // Queixa principal (Criptografada)
  historyPersonal   String?      // Histórico Pessoal (Criptografada)
  historyFamily     String?      // Histórico Familiar (Criptografada)
  historySocial     String?      // Histórico Social/Econômico (Criptografada)
  historySchool     String?      // Histórico Escolar (Criptografada)
  historyOcupational String?     // Histórico Ocupacional (Criptografada)
  medicinesAlergies String?      // Uso de Medicamentos / Alergias (Criptografada)
  structuredData    Json?        // Armazena campos customizáveis ou escores aplicados
  status            String       @default("DRAFT") // DRAFT, FINALIZED
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  finalizedAt       DateTime?
  
  case              Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  beneficiary       Beneficiary  @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  professional      Professional @relation(fields: [professionalId], references: [id])
}

model ClinicalEvolution {
  id                  String             @id @default(uuid())
  caseId              String
  beneficiaryId       String
  professionalId      String             // Autor da nota clínica
  appointmentId       String?            // Vínculo opcional com agendamento
  clinicalDate        DateTime           // Data e hora real da sessão
  durationMinutes     Int
  modality            String             // ONLINE, IN_PERSON, HYBRID
  contentEncrypted    String             // Conteúdo rico da sessão criptografado
  summary             String?            // Resumo de visibilidade pública/compartilhada
  formatType          String             @default("FREE_TEXT") // FREE_TEXT, SOAP
  visibility          String             @default("PRIVATE_TO_AUTHOR") // PRIVATE_TO_AUTHOR, SHARED_WITH_CASE_TEAM, GLOBAL_CLINICAL
  status              String             @default("DRAFT") // DRAFT, SIGNED, AMENDED
  digitalSignatureHash String?
  signatureMetadata   Json?              // IP, timestamp e certificado utilizado
  signedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  case                Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  beneficiary         Beneficiary        @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  professional        Professional       @relation(fields: [professionalId], references: [id])
  appointment         Appointment?       @relation(fields: [appointmentId], references: [id])
  erratas             EvolutionErrata[]
  documents           ClinicalDocument[]
}

model EvolutionErrata {
  id                      String            @id @default(uuid())
  evolutionId             String
  professionalId          String
  correctionTextEncrypted String
  justification           String
  digitalSignatureHash    String?
  createdAt               DateTime          @default(now())

  evolution               ClinicalEvolution @relation(fields: [evolutionId], references: [id], onDelete: Cascade)
  professional            Professional      @relation(fields: [professionalId], references: [id])
}

model Diagnosis {
  id                   String       @id @default(uuid())
  caseId               String
  beneficiaryId        String
  professionalId       String
  classificationSystem String       // CID_10, CID_11, DSM_5
  code                 String       // Ex: F41.1
  description          String       // Transtorno de ansiedade generalizada
  diagnosticStatus     String       @default("ACTIVE") // ACTIVE, RESOLVED, RULED_OUT
  clinicalNotes        String?
  createdAt            DateTime     @default(now())
  resolvedAt           DateTime?

  case                 Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  beneficiary          Beneficiary  @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  professional         Professional @relation(fields: [professionalId], references: [id])
}

model ClinicalDocument {
  id                   String              @id @default(uuid())
  caseId               String
  beneficiaryId        String
  professionalId       String
  evolutionId          String?
  type                 String              // PRESCRIPTION, ATTESTATION, REPORT, DECLARATION, FORWARDING, THERAPEUTIC_PLAN
  title                String
  contentEncrypted     String
  digitalSignatureHash String?
  signedAt             DateTime?
  pdfUrl               String?             // Link para bucket S3 privado
  status               String              @default("DRAFT") // DRAFT, SIGNED, REVOKED
  version              Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  case                 Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  beneficiary          Beneficiary         @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  professional         Professional        @relation(fields: [professionalId], references: [id])
  evolution            ClinicalEvolution?  @relation(fields: [evolutionId], references: [id])
  accessLogs           DocumentAccessLog[]
}

model ClinicalAttachment {
  id             String                 @id @default(uuid())
  caseId         String
  beneficiaryId  String
  professionalId String
  title          String
  documentType   String                 // EXAM_RESULT, EXTERNAL_REPORT, PATIENT_ART, CONSENT_FORM, OTHER
  fileS3Key      String                 // Caminho privado no S3
  mimeType       String
  fileSize       Int
  visibility     String                 @default("PRIVATE_TO_AUTHOR") // PRIVATE_TO_AUTHOR, SHARED_WITH_CASE_TEAM
  uploadedAt     DateTime               @default(now())
  retentionUntil DateTime?

  case           Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  beneficiary    Beneficiary            @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  professional   Professional           @relation(fields: [professionalId], references: [id])
  accessLogs     AttachmentAccessLog[]
}

model DocumentAccessLog {
  id             String           @id @default(uuid())
  documentId     String
  professionalId String
  action         String           // VIEW, DOWNLOAD, EXPORT, PRINT
  justification  String?          // Justificativa se for acesso via break-glass
  ipAddress      String
  userAgent      String
  timestamp      DateTime         @default(now())

  document       ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  professional   Professional     @relation(fields: [professionalId], references: [id])
}

model AttachmentAccessLog {
  id             String             @id @default(uuid())
  attachmentId   String
  professionalId String
  action         String             // VIEW, DOWNLOAD
  justification  String?
  ipAddress      String
  userAgent      String
  timestamp      DateTime           @default(now())

  attachment     ClinicalAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  professional   Professional       @relation(fields: [professionalId], references: [id])
}

model ClinicalScale {
  id             String       @id @default(uuid())
  caseId         String
  beneficiaryId  String
  professionalId String
  scaleName      String       // GAD-7, PHQ-9, BECK, SOCIAL_SCREENING
  version        String
  score          Int
  answers        Json         // Contém as respostas em formato estruturado
  interpretation String
  appliedAt      DateTime     @default(now())

  case           Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  beneficiary    Beneficiary  @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id])
}

model SecurityAuditLog {
  id             String   @id @default(uuid())
  actorId        String
  actorName      String
  role           String
  action         String   // BREAK_GLASS_OVERRIDE, UNAUTHORIZED_ACCESS_ATTEMPT, READ_RECORD, SIGN_RECORD, EXPORT_RECORD
  targetEntity   String   // BENEFICIARY, EVOLUTION, DOCUMENT, ATTACHMENT
  targetEntityId String
  justification  String?
  ipAddress      String
  userAgent      String
  timestamp      DateTime @default(now())
}

model IndividualCarePlan {
  id                  String               @id @default(uuid())
  caseId              String
  generalObjectives   String               // Objetivos gerais do cuidado
  specificObjectives  String               // Objetivos específicos do cuidado
  familyCommitments   String?              // Responsabilidades da família/beneficiário
  status              String               @default("ACTIVE") // ACTIVE, COMPLETED, REVISED, SUSPENDED
  version             Int                  @default(1)
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  signedById          String
  signedAt            DateTime?

  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  signedBy            Professional         @relation(fields: [signedById], references: [id])
  goals               PicGoal[]
  history             PicVersion[]
}

model PicGoal {
  id                  String               @id @default(uuid())
  picId               String
  description         String               // Detalhes da meta
  intervention        String               // Intervenção associada
  indicator           String               // Indicador de sucesso
  targetDate          DateTime
  status              String               @default("PENDING") // PENDING, IN_PROGRESS, ACHIEVED, NOT_ACHIEVED
  responsibleId       String               // Profissional ou beneficiário responsável
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  pic                 IndividualCarePlan   @relation(fields: [picId], references: [id], onDelete: Cascade)
  responsible         Professional         @relation(fields: [responsibleId], references: [id])
}

model PicVersion {
  id                  String               @id @default(uuid())
  picId               String
  version             Int
  changedById         String
  changeSummary       String
  contentSnapshot     Json                 // Estado completo do PIC em formato JSON
  createdAt           DateTime             @default(now())

  pic                 IndividualCarePlan   @relation(fields: [picId], references: [id], onDelete: Cascade)
  changedBy           Professional         @relation(fields: [changedById], references: [id])
}

model CaseMeeting {
  id                  String               @id @default(uuid())
  caseId              String
  meetingDate         DateTime
  agenda              String               // Pauta da reunião
  minutes             String               // Ata e discussões clínicas/sociais
  decisions           String               // Decisões tomadas
  pendingTasks        Json?                // Lista de tarefas estruturadas: { task, responsibleId, deadline }
  
  createdAt           DateTime             @default(now())

  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  participants        CaseMeetingParticipant[]
}

model CaseMeetingParticipant {
  meetingId           String
  professionalId      String
  role                String?              // Papel na reunião
  attended            Boolean              @default(true)

  meeting             CaseMeeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  professional        Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([meetingId, professionalId])
}

model Referral {
  id                  String               @id @default(uuid())
  caseId              String
  professionalId      String               // Autor do encaminhamento
  type                String               // INTERNAL, EXTERNAL
  destination         String               // CAPS, CRAS, CREAS, Hospital, Defensoria Pública, Conselho Tutelar, Escola, etc.
  reason              String               // Motivo e histórico clínico
  status              String               @default("PENDING") // PENDING, SENT, COMPLETED, NO_SHOW, CANCELLED
  result              String?              // Retorno do encaminhamento
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  professional        Professional         @relation(fields: [professionalId], references: [id])
}

model CaseAlert {
  id                  String               @id @default(uuid())
  caseId              String
  type                String               // NO_VISIT_PROLONGED, META_OVERDUE, PIC_REVISION_OVERDUE, PENDING_DOCUMENT, REFERRAL_NO_RETURN
  message             String
  status              String               @default("ACTIVE") // ACTIVE, RESOLVED
  severity            String               @default("MEDIUM") // HIGH, MEDIUM, LOW
  
  createdAt           DateTime             @default(now())
  resolvedAt          DateTime?
  
  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// ─── MÓDULO 08 — GESTÃO FINANCEIRA E CAPTAÇÃO DE RECURSOS ───

model CostCenter {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  type          String         // PROJECT, PROGRAM, DEPARTMENT, CAMPAIGN, CONVENIO, UNIT
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  transactions  TransactionCostCenter[]
}

model FinancialCategory {
  id            String         @id @default(uuid())
  name          String
  type          String         // INCOME, EXPENSE, INVESTMENT
  parentId      String?
  parent        FinancialCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories FinancialCategory[] @relation("CategoryHierarchy")
  
  transactions  Transaction[]
}

model Transaction {
  id            String         @id @default(uuid())
  type          String         // INCOME, EXPENSE, INVESTMENT
  title         String
  description   String?
  amount        Float
  status        String         @default("PENDING") // PENDING, COMPLETED, CANCELLED
  dueDate       DateTime
  paymentDate   DateTime?
  
  categoryId    String
  category      FinancialCategory @relation(fields: [categoryId], references: [id])
  
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  
  donorId       String?
  donor         Donor?         @relation(fields: [donorId], references: [id])
  
  campaignId    String?
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  
  agreementId   String?
  agreement     Agreement?     @relation(fields: [agreementId], references: [id])
  
  createdById   String
  updatedById   String?
  
  documentUrl   String?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  costCenters   TransactionCostCenter[]
  reconciliations FinancialReconciliation[]
}

model TransactionCostCenter {
  transactionId String
  costCenterId  String
  percentage    Float          @default(100.0)
  
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  costCenter    CostCenter     @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@id([transactionId, costCenterId])
}

model Donor {
  id            String         @id @default(uuid())
  name          String
  document      String?        @unique
  email         String
  phone         String?
  type          String         @default("INDIVIDUAL") // INDIVIDUAL, CORPORATE
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE
  isRecurring   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  
  transactions  Transaction[]
}

model Campaign {
  id            String         @id @default(uuid())
  name          String
  description   String?
  targetAmount  Float
  raisedAmount  Float          @default(0.0)
  startDate     DateTime
  endDate       DateTime
  status        String         @default("PLANNING") // PLANNING, ACTIVE, SUSPENDED, COMPLETED
  createdAt     DateTime       @default(now())
  
  transactions  Transaction[]
}

model Agreement {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  grantor       String
  approvedAmount Float
  startDate     DateTime
  endDate       DateTime
  status        String         @default("ACTIVE") // ACTIVE, COMPLETED, AUDITING, SUSPENDED
  createdAt     DateTime       @default(now())
  
  transactions  Transaction[]
  obligations   AgreementObligation[]
}

model AgreementObligation {
  id            String         @id @default(uuid())
  agreementId   String
  title         String
  dueDate       DateTime
  status        String         @default("PENDING") // PENDING, SUBMITTED, APPROVED, OVERDUE
  description   String?
  
  agreement     Agreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model FinancialReconciliation {
  id            String         @id @default(uuid())
  transactionId String
  bankStatementId String
  reconciledAt  DateTime       @default(now())
  reconciledById String
  notes         String?
  
  transaction   Transaction    @relation(fields: [transactionId], references: [id])
}

// =========================================================================
// MÓDULO COMPLEMENTAR DE SEGURANÇA INSTITUCIONAL (MCSI)
// =========================================================================

model ProtectedProfile {
  id                 String               @id @default(uuid())
  beneficiaryId      String               @unique
  internalCode       String               @unique // ISM-0000000000
  sensitivityLevel   Int                  @default(0) // 0 to 4
  specialCategory    String?              // POLICIA_MILITAR, MAGISTRADO, TESTEMUNHA_PROTEGIDA, etc.
  riskScore          Float                @default(0.0)
  riskHeuristics     Json?                // Metadados que justificam o score de risco
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  beneficiary        Beneficiary          @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  secureVault        SecureVault?
  guardians          ChildGuardian[]
  protectiveMeasures ProtectedMeasure[]
  accessRequests     AccessRequest[]
  accessSessions     AccessSession[]
}

model SecureVault {
  id                      String           @id @default(uuid())
  protectedProfileId      String           @unique
  
  // Dados Criptografados (Armazenados como strings em base64/hex criptografadas)
  encryptedCpf            String?
  encryptedAddress        String?          // JSON estruturado de endereço criptografado
  encryptedPhone          String?
  encryptedFamilyDetails  String?          // JSON familiar criptografado
  encryptedWorkplace      String?
  encryptedAlternateAddrs String?          // Endereços alternativos criptografados
  encryptedCourtDocs      String?          // Documentação judicial sensível criptografada
  
  // Metadados de Criptografia
  ivMap                   Json             // Mapeamento de Vetores de Inicialização (IV) para cada campo
  keyId                   String           // Identificador da versão da chave KMS utilizada
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  profile                 ProtectedProfile @relation(fields: [protectedProfileId], references: [id], onDelete: Cascade)
}

model ChildGuardian {
  id                 String               @id @default(uuid())
  protectedProfileId String
  fullName           String
  relationshipType   String               // PAI, MAE, TUTOR, ACOLHEDOR, ABRIGO, CONSELHO_TUTELAR, OUTRO
  custodyType        String               // COMPARTILHADA, UNILATERAL, NENHUMA
  phone              String?
  isAuthorized       Boolean              @default(false) // Autorizado a retirar/acompanhar o menor
  isProhibited       Boolean              @default(false) // Expressamente proibido por ordem judicial
  courtOrderDetails  String?              // Detalhes da ordem de restrição (se houver)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  profile            ProtectedProfile     @relation(fields: [protectedProfileId], references: [id], onDelete: Cascade)
}

model ProtectedMeasure {
  id                 String               @id @default(uuid())
  protectedProfileId String
  processNumber      String
  measureType        String               // LEI_MARIA_DA_PENHA, DISTANCIAMENTO_MINIMO, etc.
  issuingAuthority   String               // Vara Judicial / Tribunal
  startDate          DateTime
  expirationDate     DateTime?
  restrictionsText   String               // Descrição textual das proibições impostas
  involvedPersons    Json                 // Lista de pessoas agressoras e suas descrições
  documentUrl        String?              // Link seguro no S3 criptografado para o PDF da medida
  status             String               @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  profile            ProtectedProfile     @relation(fields: [protectedProfileId], references: [id], onDelete: Cascade)
}

model AccessRequest {
  id                 String               @id @default(uuid())
  protectedProfileId String
  requesterId        String
  justification      String
  purpose            String
  durationMinutes    Int
  processNumber      String?
  status             String               @default("PENDING") // PENDING, APPROVED, DENIED, EXPIRED
  authorizedById     String?
  createdAt          DateTime             @default(now())
  expiresAt          DateTime?

  profile            ProtectedProfile     @relation(fields: [protectedProfileId], references: [id], onDelete: Cascade)
  requester          Professional         @relation("RequesterProf", fields: [requesterId], references: [id])
  authorizedBy       Professional?        @relation("AuthorizerProf", fields: [authorizedById], references: [id])
}

model AccessSession {
  id                 String               @id @default(uuid())
  protectedProfileId String
  professionalId     String
  accessRequestId    String?
  ipAddress          String
  userAgent          String
  startTime          DateTime             @default(now())
  endTime            DateTime?
  durationSeconds    Int?
  actionsPerformed   Json                 // Lista estruturada de ações tomadas durante o acesso

  profile            ProtectedProfile     @relation(fields: [protectedProfileId], references: [id], onDelete: Cascade)
  professional       Professional         @relation(fields: [professionalId], references: [id])
}

model AuditLogSignature {
  id                 String               @id @default(uuid())
  logId              String               @unique // ID do log na tabela SecurityAuditLog ou Elasticsearch
  logHash            String               // Hash SHA-256 do conteúdo do log
  previousLogHash    String               // Hash SHA-256 do log anterior (Encadeamento de Ledger)
  signature          String               // Assinatura digital assimétrica usando chave privada do servidor
  createdAt          DateTime             @default(now())
}

model BehaviorAlert {
  id                 String               @id @default(uuid())
  userId             String
  alertType          String               // MASS_QUERIES, UNUSUAL_EXPORT, OUT_OF_HOURS, CONCURRENT_SESSIONS, EXCESSIVE_DOWNLOAD
  description        String
  severity           String               @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status             String               @default("NEW") // NEW, INVESTIGATING, RESOLVED, FALSE_POSITIVE
  detectedAt         DateTime             @default(now())
  resolvedAt         DateTime?
  resolvedById       String?
  
  resolvedBy         Professional?        @relation("AlertResolver", fields: [resolvedById], references: [id])
}

// =========================================================================
// MÓDULO ACTG: AURA COMMUNICATION & TELEATTENDANCE GATEWAY
// =========================================================================

model CommunicationProvider {
  id              String   @id @default(uuid())
  name            String
  type            String   // WHATSAPP_BUSINESS | GOOGLE_MEET | TEAMS | ZOOM | WEBEX | JITSI | WEBRTC_NATIVE
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE | DEPRECATED
  isEnabled       Boolean  @default(true)
  supportsVideo   Boolean  @default(false)
  supportsAudio   Boolean  @default(false)
  supportsChat    Boolean  @default(false)
  supportsNotify  Boolean  @default(true)
  configSchema    Json?    // JSON schema das configurações necessárias
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        CommunicationAccount[]
  healthStatuses  ProviderHealthStatus[]
  channels        AppointmentChannel[]
}

model CommunicationAccount {
  id              String   @id @default(uuid())
  providerId      String
  name            String
  environment     String   @default("PRODUCTION") // PRODUCTION | STAGING | SANDBOX
  vaultPath       String   // HashiCorp Vault / AWS Secrets Manager path
  webhookUrl      String?
  webhookSecretHash String? // HMAC-SHA256 hash of webhook secret
  isActive        Boolean  @default(true)
  lastHealthCheck DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider        CommunicationProvider @relation(fields: [providerId], references: [id])
  channels        AppointmentChannel[]
}

model AppointmentChannel {
  id                String   @id @default(uuid())
  appointmentId     String   @unique
  channelType       String   // WHATSAPP_BUSINESS | GOOGLE_MEET | TEAMS | IN_PERSON | PHONE | HYBRID | WEBRTC_NATIVE
  providerId        String?
  accountId         String?
  selectedByUserId  String?
  preferenceSource  String   @default("INSTITUTIONAL") // BENEFICIARY | PROFESSIONAL | INSTITUTIONAL | FALLBACK
  isFallback        Boolean  @default(false)
  originalChannelType String? // Canal original antes do fallback
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointment       Appointment            @relation(fields: [appointmentId], references: [id])
  provider          CommunicationProvider? @relation(fields: [providerId], references: [id])
  account           CommunicationAccount?  @relation(fields: [accountId], references: [id])
  externalMeeting   ExternalMeeting?
}

model ExternalMeeting {
  id                  String   @id @default(uuid())
  appointmentChannelId String  @unique
  externalMeetingId   String   // ID da reunião no provedor externo
  joinUrl             String   // Link de acesso para participantes
  hostJoinUrl         String?  // Link do anfitrião (quando diferente)
  providerType        String   // GOOGLE_MEET | TEAMS | ZOOM | etc
  status              String   @default("ACTIVE") // ACTIVE | CANCELLED | COMPLETED | EXPIRED
  idempotencyKey      String   @unique // Previne duplicidade
  scheduledStart      DateTime
  scheduledEnd        DateTime
  cancelledAt         DateTime?
  cancellationReason  String?
  completedAt         DateTime?
  rawMetadata         Json?    // Dados específicos do provedor (sanitizados)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appointmentChannel  AppointmentChannel @relation(fields: [appointmentChannelId], references: [id])
}

model CommunicationEvent {
  id                String   @id @default(uuid())
  appointmentId     String?
  externalMeetingId String?
  eventType         String   // SESSION_CREATED | SESSION_UPDATED | SESSION_CANCELLED | SESSION_JOINED | SESSION_COMPLETED | NOTIFICATION_SENT | FALLBACK_TRIGGERED | PROVIDER_ERROR
  providerType      String?
  source            String   // AURA | PROVIDER_WEBHOOK
  actorId           String?
  actorType         String?  // BENEFICIARY | PROFESSIONAL | SYSTEM
  payload           Json?    // Sanitized payload (sem dados clínicos)
  correlationId     String?
  timestamp         DateTime @default(now())
}

model WebhookEvent {
  id              String   @id @default(uuid())
  providerId      String?
  externalEventId String?
  eventType       String
  rawPayload      Bytes?   // Criptografado em repouso
  signatureValid  Boolean  @default(false)
  processed       Boolean  @default(false)
  appointmentId   String?  // Após correlação
  processingError String?
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
}

model NotificationLog {
  id              String   @id @default(uuid())
  appointmentId   String?
  recipientId     String
  recipientType   String   // BENEFICIARY | PROFESSIONAL
  channel         String   // WHATSAPP | EMAIL | SMS | PUSH | PORTAL
  eventType       String   // APPOINTMENT_CREATED | APPOINTMENT_CONFIRMED | REMINDER_7D | REMINDER_24H | REMINDER_2H | REMINDER_30MIN | APPOINTMENT_CANCELLED | APPOINTMENT_RESCHEDULED | SESSION_STARTED | SESSION_COMPLETED
  idempotencyKey  String   @unique // recipientId:appointmentId:eventType:channel
  status          String   @default("PENDING") // PENDING | SENT | DELIVERED | FAILED
  messageContent  String?  // Sanitized — sem dados clínicos
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())
}

model CommunicationPreference {
  id                 String   @id @default(uuid())
  entityId           String
  entityType         String   // BENEFICIARY | PROFESSIONAL
  preferredChannel   String   @default("PORTAL") // WHATSAPP | EMAIL | SMS | PUSH | PORTAL
  fallbackChannels   Json     @default("[]")
  allowWhatsApp      Boolean  @default(false)
  allowEmail         Boolean  @default(true)
  allowSms           Boolean  @default(false)
  allowPush          Boolean  @default(true)
  reminderIntervals  Json     @default("[\"24h\", \"2h\"]")
  accessibilityNeeds Json?
  consentRecordedAt  DateTime?
  consentVersion     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([entityId, entityType])
}

model ProviderHealthStatus {
  id            String   @id @default(uuid())
  providerId    String
  status        String   // ONLINE | DEGRADED | UNAVAILABLE
  latencyMs     Int?
  errorRate     Float?
  lastCheckedAt DateTime @default(now())
  lastOnlineAt  DateTime?
  incidentId    String?

  provider      CommunicationProvider @relation(fields: [providerId], references: [id])
}

model CommunicationTemplate {
  id           String   @id @default(uuid())
  providerId   String?
  name         String   // Ex: APPOINTMENT_CONFIRMATION_PT
  eventType    String   // Evento que dispara este template
  channel      String   // WHATSAPP | EMAIL | SMS
  language     String   @default("pt_BR")
  subject      String?  // Para e-mail
  body         String   // Template com placeholders {name}, {date}, {link}
  isActive     Boolean  @default(true)
  mcsiMaxLevel Int      @default(2) // Nível MCSI máximo que pode usar este template
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =========================================================================
// MÓDULO DE AUTENTICAÇÃO, IAM, RBAC & GOVERNANÇA GLOBAL (PROMPT 189)
// =========================================================================

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  name                String
  passwordHash        String
  role                String                 @default("STAFF") // SUPER_USER_UNIVERSAL | ADMINISTRADOR | GESTOR | COORDENADOR | FINANCEIRO | RH | COMUNICACAO | PROFISSIONAL | AUDITOR | OPERADOR | COLABORADOR
  scope               String                 @default("TENANT") // GLOBAL | TENANT | PROJECT | SELF
  status              String                 @default("ACTIVE") // ACTIVE | INACTIVE | BLOCKED
  mfaEnabled          Boolean                @default(false)
  mfaSecret           String?
  lastLoginAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  userRoles           UserRole[]
  delegationsGiven    UserDelegation[]       @relation("Delegator")
  delegationsReceived UserDelegation[]       @relation("Delegatee")
  impersonationsRun   ImpersonationSession[] @relation("ImpersonatorAdmin")
  impersonatedAs      ImpersonationSession[] @relation("TargetUser")
}

model Role {
  id               String           @id @default(uuid())
  name             String           @unique // SUPER_USER_UNIVERSAL, ADMINISTRADOR, GESTOR, COORDENADOR, FINANCEIRO, RH, COMUNICACAO, PROFISSIONAL, AUDITOR, OPERADOR, COLABORADOR
  description      String?
  isSystemRole     Boolean          @default(true)
  scope            String           @default("TENANT")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  userRoles        UserRole[]
  rolePermissions  RolePermission[]
  delegations      UserDelegation[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // ex: users:create, users:delegate, financial:read, etc.
  name        String
  category    String           // USER_MGMT, FINANCIAL, CARE, SYSTEM, SECURITY, INTEGRATIONS
  description String?
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserDelegation {
  id           String    @id @default(uuid())
  delegatorId  String
  delegateeId  String
  roleId       String
  scope        String    @default("TENANT")
  status       String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  delegator    User      @relation("Delegator", fields: [delegatorId], references: [id])
  delegatee    User      @relation("Delegatee", fields: [delegateeId], references: [id])
  role         Role      @relation(fields: [roleId], references: [id])
}

model ImpersonationSession {
  id           String    @id @default(uuid())
  adminId      String
  targetUserId String
  reason       String
  token        String    @unique
  status       String    @default("ACTIVE") // ACTIVE, ENDED, EXPIRED
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?

  admin        User      @relation("ImpersonatorAdmin", fields: [adminId], references: [id])
  targetUser   User      @relation("TargetUser", fields: [targetUserId], references: [id])
}

// =========================================================================
// MÓDULO LGPD/GDPR: PRIVACIDADE, CONSENTIMENTO & DIREITOS DO TITULAR
// =========================================================================

model DataConsent {
  id                String    @id @default(uuid())
  entityId          String    // ID do titular (beneficiário, usuário, profissional)
  entityType        String    // BENEFICIARY | PROFESSIONAL | USER | VISITOR
  tenantId          String    @default("default")
  consentVersion    String    // Versão do termo (ex: "2025-08-01-v3")
  purposes          Json      // Array de finalidades aceitas
  legalBasis        String    // CONSENTIMENTO | CONTRATO | OBRIGACAO_LEGAL | INTERESSE_LEGITIMO
  isActive          Boolean   @default(true)
  isMinor           Boolean   @default(false)
  guardianId        String?
  ipAddress         String?
  userAgent         String?
  collectionChannel String    @default("WEB")
  expiresAt         DateTime?
  withdrawnAt       DateTime?
  withdrawalReason  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requests          DataSubjectRequest[]

  @@index([entityId, entityType])
  @@index([tenantId, isActive])
}

model DataSubjectRequest {
  id              String    @id @default(uuid())
  consentId       String?
  entityId        String
  entityType      String
  tenantId        String    @default("default")
  requestType     String    // ACCESS | PORTABILITY | RECTIFICATION | ERASURE | RESTRICTION | OBJECTION
  status          String    @default("PENDING")
  description     String?
  requestedBy     String?
  assignedTo      String?
  dueDate         DateTime  // Prazo legal (15 dias úteis)
  completedAt     DateTime?
  rejectionReason String?
  evidenceLog     Json?
  exportUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consent         DataConsent? @relation(fields: [consentId], references: [id])

  @@index([entityId, status])
  @@index([tenantId, requestType, status])
}

model DataProcessingLog {
  id              String   @id @default(uuid())
  entityId        String
  entityType      String
  tenantId        String   @default("default")
  operation       String   // READ | CREATE | UPDATE | DELETE | EXPORT | ANONYMIZE
  resource        String
  resourceId      String?
  purpose         String
  legalBasis      String
  actorId         String?
  actorType       String   @default("SYSTEM")
  isAutomated     Boolean  @default(false)
  dataFields      Json?
  ipAddress       String?
  correlationId   String?
  timestamp       DateTime @default(now())

  @@index([entityId, timestamp])
  @@index([tenantId, operation, timestamp])
}

model AnonymizationRecord {
  id              String   @id @default(uuid())
  entityId        String
  entityType      String
  tenantId        String   @default("default")
  technique       String   // PSEUDONYMIZATION | FULL_ERASURE
  fieldsProcessed Json
  requestId       String?
  performedBy     String?
  verifiedBy      String?
  legalBasis      String
  completedAt     DateTime @default(now())
  retentionUntil  DateTime?
  notes           String?
}

// =========================================================================
// MÓDULO PWA & OFFLINE-FIRST: SINCRONIZAÇÃO DE AGENTES DE CAMPO (Fase P13)
// =========================================================================

model OfflineSyncBatch {
  id            String   @id @default(uuid())
  deviceId      String   // Identificador do dispositivo móvel do agente
  agentId       String   // ID do agente de campo
  tenantId      String   @default("default")
  totalItems    Int
  syncedItems   Int      @default(0)
  failedItems   Int      @default(0)
  status        String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | PARTIAL_FAILURE
  payload       Json     // Lote de triagens e notas capturadas offline
  clientTime    DateTime // Data/hora local do dispositivo no momento da captura
  syncedAt      DateTime?
  createdAt     DateTime @default(now())

  logs          OfflineSyncLog[]

  @@index([agentId, status])
  @@index([deviceId, createdAt])
}

model OfflineSyncLog {
  id            String   @id @default(uuid())
  batchId       String
  itemType      String   // TRIAGE | CLINICAL_EVOLUTION | BENEFICIARY
  localId       String   // ID gerado offline no IndexedDB
  serverId      String?  // ID final gerado no PostgreSQL
  status        String   // SUCCESS | FAILED | CONFLICT
  errorMessage  String?
  processedAt   DateTime @default(now())

  batch         OfflineSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// =========================================================================
// MÓDULO ASPS: AURA SOCIAL PROGRAMS SERVICE
// Integração CGI-Gestão de Projetos ↔ Página Pública de Programas Sociais
// =========================================================================

model SocialProgram {
  id                    String   @id @default(uuid())
  title                 String
  description           String
  fullDescription       String?
  category              String   @default("Outro")
  status                String   @default("planejamento") // ativo | planejamento | concluido | suspenso
  isPublic              Boolean  @default(false)
  targetAudience        String?
  objectives            Json?    // String[]
  fundingSources        Json?    // String[]
  results               String?
  coordinator           String   @default("")
  team                  Json     @default("[]") // String[]
  tags                  Json     @default("[]") // String[]
  bannerUrl             String?
  startDate             String   @default("")
  endDate               String   @default("")
  budget                Float    @default(0)
  raised                Float    @default(0)
  targetBeneficiaries   Int      @default(0)
  activeBeneficiaries   Int      @default(0)
  progress              Int      @default(0)
  centroCusto           String?
  notas                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, isPublic])
  @@index([createdAt])
}

// =========================================================================
// MÓDULO BREAK-GLASS: ACESSO EXCEPCIONAL DE EMERGÊNCIA (MCSI Nível 4)
// GAP-P1-04 — Notificação em Tempo Real para Acessos de Emergência
// =========================================================================

model BreakGlassSession {
  id                  String    @id @default(uuid())

  // Quem solicitou
  professionalId      String    // Professional.id (solicitante)
  professionalName    String    // Nome para log imutável

  // Para qual beneficiário
  beneficiaryId       String    // Beneficiary.id
  beneficiaryName     String    // Nome para log imutável

  // Justificativa clínica obrigatória
  justification       String    // Texto completo da justificativa
  emergencyType       String    // RISCO_VIDA, SURTO_AGUDO, DESAPARECIMENTO, CRISE_SUICIDA, OUTRO

  // Status do fluxo
  status              String    @default("PENDING")
  // PENDING     — aguardando aprovação automática (< 30s) ou manual
  // ACTIVE      — acesso liberado, dentro da janela de validade
  // EXPIRED     — janela expirada automaticamente
  // REVOKED     — revogado manualmente por gestor/DPO
  // DENIED      — negado

  // Controle de tempo
  requestedAt         DateTime  @default(now())
  approvedAt          DateTime?
  expiresAt           DateTime? // Padrão: requestedAt + 4h
  revokedAt           DateTime?
  revokedById         String?   // User.id que revogou

  // Contexto técnico para forensics
  ipAddress           String
  userAgent           String
  tenantId            String    @default("default")

  // Auditoria
  auditLogId          String?   // SecurityAuditLog.id gerado no momento do break-glass
  notificationSentAt  DateTime? // Quando a notificação de alerta foi disparada

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([beneficiaryId, status])
  @@index([professionalId, requestedAt])
  @@index([status, expiresAt])
  @@index([tenantId, requestedAt])
}

// =========================================================================
// MÓDULO LGPD: PRIVACIDADE E DIREITOS DO TITULAR (Lei 13.709/2018)
// GAP-P2-06 — Fluxo de Anonimização e Registros de Consentimento
// =========================================================================

model DataConsent {
  id                 String    @id @default(uuid())
  entityId           String
  entityType         String
  tenantId           String    @default("default")
  consentVersion     String
  purposes           Json
  legalBasis         String
  isActive           Boolean   @default(true)
  isMinor            Boolean   @default(false)
  guardianId         String?
  ipAddress          String?
  userAgent          String?
  collectionChannel  String    @default("WEB")
  withdrawnAt        DateTime?
  withdrawalReason   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  requests           DataSubjectRequest[]

  @@index([entityId, isActive])
  @@index([tenantId])
}

model DataSubjectRequest {
  id           String    @id @default(uuid())
  entityId     String
  entityType   String
  tenantId     String    @default("default")
  requestType  String    // ACCESS, PORTABILITY, RECTIFICATION, ERASURE, RESTRICTION, OBJECTION
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  description  String?
  requestedBy  String?
  consentId    String?
  dueDate      DateTime
  completedAt  DateTime?
  evidenceLog  Json?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  consent      DataConsent? @relation(fields: [consentId], references: [id])

  @@index([entityId, tenantId])
  @@index([status, dueDate])
}

model AnonymizationRecord {
  id               String    @id @default(uuid())
  entityId         String
  entityType       String
  tenantId         String    @default("default")
  technique        String    // PSEUDONYMIZATION, FULL_ERASURE
  fieldsProcessed  Json
  requestId        String?
  performedBy      String    @default("DPO_SYSTEM")
  legalBasis       String
  retentionUntil   DateTime?
  createdAt        DateTime  @default(now())

  @@index([entityId, tenantId])
}

model DataProcessingLog {
  id             String    @id @default(uuid())
  entityId       String
  entityType     String
  tenantId       String    @default("default")
  operation      String
  resource       String
  resourceId     String?
  purpose        String
  legalBasis     String
  actorId        String?
  actorType      String    @default("SYSTEM")
  isAutomated    Boolean   @default(true)
  dataFields     Json
  correlationId  String?
  createdAt      DateTime  @default(now())

  @@index([entityId, tenantId])
}

